# ==============================================================================
# SLTNOC Unified Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# Used by:
#  1. Node.js Express Backend (via dotenv)
#  2. Flutter Mobile Application (via flutter run --dart-define-from-file=.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 📱 Flutter Mobile Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_BASE_URL=http://localhost:3000
SOAP_ENDPOINT=https://fmt.slt.com.lk/fmt/WClogin.asmx
DEV_MODE=true
DEV_USERNAME=testuser
DEV_PASSWORD=dev-password
DEV_DISPLAY_NAME=Test User

# ------------------------------------------------------------------------------
# 🖥️ Node.js Express Backend Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.14:3000,https://sltnoc-api.azurewebsites.net

# ------------------------------------------------------------------------------
# 🔐 Shared API & JWT Authentication
# ------------------------------------------------------------------------------
API_KEY=sltnoc-dev-secret-key-2026
JWT_SECRET=sltnoc-super-secure-jwt-secret-2026-production
JWT_EXPIRES_IN=7d
REQUIRE_AUTH=true

# ------------------------------------------------------------------------------
# 🗄️ Database Connection (SQL Server / Azure)
# ------------------------------------------------------------------------------
# Set KEY_VAULT_NAME if fetching credentials from Azure Key Vault
KEY_VAULT_NAME=
DB_USER=sa
DB_PASSWORD=
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=TMS
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433

# ------------------------------------------------------------------------------
# 🤖 Ollama Local LLM Configuration
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# 🛠️ Debugging & Diagnostics
# ------------------------------------------------------------------------------
DEBUG_CHUNKS=false
