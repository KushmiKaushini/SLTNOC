# ==============================================================================
# SLTNOC — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 🔐 Secrets & Environment (NEVER commit these)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
env.json
!env.json.example

# ------------------------------------------------------------------------------
# 📦 Node.js / npm
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ------------------------------------------------------------------------------
# 🦋 Flutter / Dart
# ------------------------------------------------------------------------------
# Build output
/build/

# Generated Dart/Flutter files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/

# Flutter generated plugin registrants (auto-regenerated on build)
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift
ios/Flutter/GeneratedPluginRegistrant.h
ios/Flutter/GeneratedPluginRegistrant.m

# iOS/macOS build
ios/Pods/
ios/.symlinks/
macos/Pods/
ios/Flutter/.last_build_id
**/ios/Flutter/.last_build_id

# Android generated
android/local.properties
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
/android/app/debug
/android/app/profile
/android/app/release

# ------------------------------------------------------------------------------
# 🛠️ Build Artifacts & Symbolication
# ------------------------------------------------------------------------------
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 🖥️ IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code (keep launch.json and settings.json in source control)
# .vscode/

# Xcode
*.xcworkspace/
*.xcodeproj/xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ------------------------------------------------------------------------------
# 💻 OS Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.class
*.pyc
*.log

# ------------------------------------------------------------------------------
# 📦 FVM (Flutter Version Manager)
# ------------------------------------------------------------------------------
.fvm/
.fvmrc

# ------------------------------------------------------------------------------
# 🛠️ Misc Dev Tools
# ------------------------------------------------------------------------------
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
