<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config>
        <domain includeSubdomains="true">fmt.slt.com.lk</domain>
        <trust-anchors>
            <certificates src="@raw/slt_fullchain" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
